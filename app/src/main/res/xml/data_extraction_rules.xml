<?xml version="1.0" encoding="utf-8"?>
<!-- Vault contents never leave the device: cloud backup and device transfer are fully disabled. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
